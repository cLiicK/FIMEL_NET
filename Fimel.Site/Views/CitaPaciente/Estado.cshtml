@model string
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    <title>Tu cita</title>
    <link rel="icon" type="image/png" sizes="32x32" href="~/img/favicon-32x32.png">
    <style>
        body { font-family: Arial, sans-serif; background: #f6f8fa; color: #1a2a3a; margin: 0; }
        .caja { max-width: 420px; margin: 18vh auto 0; background: #fff; border-radius: 12px; padding: 28px 24px; text-align: center; box-shadow: 0 2px 12px rgba(0,0,0,.06); }
        .caja img { max-width: 140px; margin-bottom: 18px; }
        .caja p { font-size: 16px; line-height: 1.5; margin: 0; }
    </style>
</head>
<body>
    <div class="caja">
        <img src="~/img/logo_fimel_correo.png" alt="Fimel">
        <p>@Model</p>
    </div>
</body>
</html>
