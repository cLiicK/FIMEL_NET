@model SuscripcionUsuario?
@{
    ViewData["Title"] = "Mi suscripción";
    string? estado = Model?.Estado;
    List<PlanSuscripcion> planes = ViewBag.Planes ?? new List<PlanSuscripcion>();
    PlanSuscripcion? mensual = planes.FirstOrDefault(p => p.Meses == 1);
    Func<int, string> pesos = monto => "$" + monto.ToString("N0");
    Func<int, string> periodo = meses => meses == 1 ? "al mes" : meses == 12 ? "al año" : $"cada {meses} meses";
    bool canceladaConAcceso = estado == EstadosSuscripcion.Cancelada && Model?.PagadoHasta >= DateTime.Today;
    bool vigente = estado == EstadosSuscripcion.Prueba || estado == EstadosSuscripcion.Activa || estado == EstadosSuscripcion.Exenta
        || estado == EstadosSuscripcion.Morosa || canceladaConAcceso;
    bool puedeCancelar = (estado == EstadosSuscripcion.Prueba || estado == EstadosSuscripcion.Activa || estado == EstadosSuscripcion.Morosa)
        && Model?.CancelaAlFinPeriodo != true && !string.IsNullOrWhiteSpace(Model?.FlowSubscriptionId);
    string badge = estado switch
    {
        EstadosSuscripcion.Prueba => "bg-info",
        EstadosSuscripcion.Activa => "bg-success",
        EstadosSuscripcion.Exenta => "bg-secondary",
        EstadosSuscripcion.Morosa => "bg-danger",
        _ => "bg-warning text-dark"
    };
}

<div id="content-wrapper" class="container-9">
    <div class="row">
        <div class="col-12">
            <div class="container">
                <h2 class="colorfimel-blue">Mi suscripción</h2>
            </div>
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-12 col-xl-10">
            <div class="container">

                @if (TempData["MensajeExito"] != null)
                {
                    <div class="alert alert-success">@TempData["MensajeExito"]</div>
                }
                @if (TempData["MensajeError"] != null)
                {
                    <div class="alert alert-danger">@TempData["MensajeError"]</div>
                }

                <div class="card">
                    <div class="card-body">
                        @if (Model == null || !vigente)
                        {
                            <h5 class="card-title">Suscríbete a Fimel</h5>
                            <p class="card-text">
                                Elige tu plan e inscribe tu tarjeta de crédito o débito en Flow. <strong>Los primeros 30 días son gratis</strong>
                                y el primer cobro se hace al terminar la prueba. Puedes cancelar cuando quieras.
                            </p>
                            @if (estado == EstadosSuscripcion.Pendiente)
                            {
                                <p class="text-muted small">Tienes una inscripción de tarjeta sin terminar. Puedes retomarla eligiendo un plan.</p>
                            }
                            @if (Model?.PruebaUsada == true)
                            {
                                <p class="text-muted small">Ya usaste tu prueba gratis, así que el primer cobro se hace al inscribir la tarjeta.</p>
                            }

                            @if (planes.Count == 0)
                            {
                                <div class="alert alert-warning mb-0">Todavía no hay planes disponibles.</div>
                            }
                            else
                            {
                                <div class="row g-3">
                                    @foreach (PlanSuscripcion plan in planes)
                                    {
                                        int? descuento = mensual != null && plan.Meses > 1
                                            ? (int)Math.Round(100 - plan.Monto * 100.0 / (mensual.Monto * plan.Meses))
                                            : null;
                                        bool destacado = plan.Meses == planes.Max(p => p.Meses);

                                        <div class="col-12 col-sm-6 col-xl-3">
                                            <div class="card h-100 @(destacado ? "border-primary" : "")">
                                                <div class="card-body d-flex flex-column">
                                                    <h6 class="card-title">
                                                        @plan.Nombre
                                                        @if (destacado)
                                                        {
                                                            <span class="badge bg-primary ms-1">Mejor precio</span>
                                                        }
                                                    </h6>
                                                    <p class="fs-4 fw-bold mb-0">@pesos(plan.Monto)</p>
                                                    <p class="text-muted small mb-2">@periodo(plan.Meses)</p>
                                                    @if (plan.Meses > 1)
                                                    {
                                                        <p class="small mb-2">
                                                            Equivale a @pesos((int)Math.Round(plan.Monto / (double)plan.Meses)) al mes
                                                            @if (descuento > 0)
                                                            {
                                                                <span class="badge bg-success ms-1">Ahorras @descuento%</span>
                                                            }
                                                        </p>
                                                    }
                                                    <form method="post" asp-action="Suscribirse" asp-controller="Suscripcion" class="mt-auto">
                                                        <input type="hidden" name="idPlan" value="@plan.Id" />
                                                        <button type="submit" class="btn @(destacado ? "btn-primary" : "btn-outline-primary") w-100">Elegir</button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        }
                        else
                        {
                            <h5 class="card-title">
                                @(Model.Plan?.Nombre ?? "Plan Fimel")
                                <span class="badge @badge ms-2">@estado</span>
                            </h5>
                            @if (estado == EstadosSuscripcion.Morosa)
                            {
                                <div class="alert alert-danger">
                                    No pudimos realizar el último cobro en tu tarjeta. Flow lo reintentará en los próximos días;
                                    revisa que tu tarjeta tenga cupo y esté vigente.
                                </div>
                            }
                            @if (Model.CancelaAlFinPeriodo || canceladaConAcceso)
                            {
                                <div class="alert alert-secondary">
                                    Cancelaste tu suscripción. Mantienes el acceso hasta el @(Model.PagadoHasta?.ToString("dd/MM/yyyy") ?? "fin del período") y no se te volverá a cobrar.
                                </div>
                            }
                            <dl class="row mb-0">
                                @if (Model.Plan != null)
                                {
                                    <dt class="col-sm-5">Valor</dt>
                                    <dd class="col-sm-7">@pesos(Model.Plan.Monto) @periodo(Model.Plan.Meses)</dd>
                                }
                                @if (estado == EstadosSuscripcion.Prueba && Model.FinPrueba.HasValue)
                                {
                                    <dt class="col-sm-5">Prueba gratis hasta</dt>
                                    <dd class="col-sm-7">@Model.FinPrueba.Value.ToString("dd/MM/yyyy") (ese día se realiza el primer cobro)</dd>
                                }
                                @if ((estado == EstadosSuscripcion.Activa || estado == EstadosSuscripcion.Morosa) && Model.PagadoHasta.HasValue)
                                {
                                    <dt class="col-sm-5">Pagado hasta</dt>
                                    <dd class="col-sm-7">@Model.PagadoHasta.Value.ToString("dd/MM/yyyy")</dd>
                                }
                                @if (!string.IsNullOrWhiteSpace(Model.Ultimos4))
                                {
                                    <dt class="col-sm-5">Tarjeta</dt>
                                    <dd class="col-sm-7">@Model.TipoTarjeta terminada en @Model.Ultimos4</dd>
                                }
                            </dl>
                            @if (puedeCancelar)
                            {
                                <form method="post" asp-action="Cancelar" asp-controller="Suscripcion" class="mt-3"
                                      onsubmit="return confirm('¿Seguro que quieres cancelar tu suscripción? Mantendrás el acceso hasta el fin del período pagado.');">
                                    <button type="submit" class="btn btn-outline-danger btn-sm">Cancelar suscripción</button>
                                </form>
                            }
                        }
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>
