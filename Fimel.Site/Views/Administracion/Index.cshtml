@{
    ViewBag.Title = "Administración";
}

<div id="content-wrapper" class="container-9">
    <div class="row">
        <div class="col-12">
            <div class="container">
                <div class="row">
                    <div class="col-12">
                        <h2 class="colorfimel-blue">Administración</h2>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="container mt-4">
        <div class="row g-3">
            <div class="col-md-4">
                <a href="@Url.Action("Usuarios", "Administracion")" class="text-decoration-none">
                    <div class="p-4 rounded border text-center h-100" style="background:#f0f9ff;">
                        <i class="fas fa-users fa-2x mb-2" style="color:#0E96CC;"></i>
                        <h5 class="mb-0">Usuarios</h5>
                        <p class="text-muted small mb-0">Crear usuarios y asignar perfiles</p>
                    </div>
                </a>
            </div>
            <div class="col-md-4">
                <a href="@Url.Action("Instituciones", "Administracion")" class="text-decoration-none">
                    <div class="p-4 rounded border text-center h-100" style="background:#f0f9ff;">
                        <i class="fas fa-hospital fa-2x mb-2" style="color:#0E96CC;"></i>
                        <h5 class="mb-0">Instituciones</h5>
                        <p class="text-muted small mb-0">Crear nuevas instituciones</p>
                    </div>
                </a>
            </div>
            <div class="col-md-4">
                <a href="@Url.Action("Modulos", "Administracion")" class="text-decoration-none">
                    <div class="p-4 rounded border text-center h-100" style="background:#f0f9ff;">
                        <i class="fas fa-table-cells fa-2x mb-2" style="color:#0E96CC;"></i>
                        <h5 class="mb-0">Módulos</h5>
                        <p class="text-muted small mb-0">Qué perfiles ven cada módulo</p>
                    </div>
                </a>
            </div>
            <div class="col-md-4">
                <a href="@Url.Action("TiposConsulta", "Administracion")" class="text-decoration-none">
                    <div class="p-4 rounded border text-center h-100" style="background:#f0f9ff;">
                        <i class="fas fa-notes-medical fa-2x mb-2" style="color:#0E96CC;"></i>
                        <h5 class="mb-0">Tipos de Consulta</h5>
                        <p class="text-muted small mb-0">Mantener el catálogo de tipos de consulta</p>
                    </div>
                </a>
            </div>
        </div>
    </div>
</div>
