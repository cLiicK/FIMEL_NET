@{
    ViewBag.Title = "Administración - Módulos";
}

<input type="hidden" id="hdnURL_ObtenerMatriz" value='@Url.Action("_ObtenerMatriz", "Administracion")' />
<input type="hidden" id="hdnURL_AsignarModuloPerfil" value='@Url.Action("_AsignarModuloPerfil", "Administracion")' />
<input type="hidden" id="hdnURL_QuitarModuloPerfil" value='@Url.Action("_QuitarModuloPerfil", "Administracion")' />

<div id="content-wrapper" class="container-9">
    <div class="row">
        <div class="col-12">
            <div class="container">
                <div class="row align-items-center">
                    <div class="col">
                        <h2 class="colorfimel-blue">Módulos ↔ Perfiles</h2>
                        <p class="text-muted small">Marca qué perfiles pueden ver cada módulo en el menú.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="container mt-3">
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle" id="tablaMatriz">
                <thead class="table-light">
                    <tr id="trEncabezadoPerfiles">
                        <th>Módulo</th>
                    </tr>
                </thead>
                <tbody id="tbodyMatriz">
                    <tr><td class="text-center text-muted py-3">Cargando...</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/js/Site/Administracion_Modulos.js?v=1.0" type="text/javascript"></script>
}
